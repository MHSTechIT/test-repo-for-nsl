# ─────────────────────────────────────────────────────────────────────
# Tata Smartflo (Click-to-Call + recordings)
# Get these from your Tata account manager / Smartflo admin panel.
#
# Until at least TATA_API_BASE_URL + (TATA_API_TOKEN or TATA_API_KEY)
# are set, the call button works in "stub mode" — it inserts a calls
# row with a fake provider_call_id but does not dial a real call.
#
# Per-agent settings (account_type, extension, agent_number, caller_id)
# are stored on the CRM user row, NOT here. Set them in the
# Create/Edit User form for each Junior Caller / Senior Caller.
# ─────────────────────────────────────────────────────────────────────
TATA_API_BASE_URL=https://api-smartflo.tatatele.com
TATA_API_PATH=/v1/click_to_call_support
TATA_API_TOKEN=
TATA_API_KEY=
TATA_CALLER_ID=
TATA_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Meta Conversions API (server-side Pixel events)
# Events Manager → your pixel (1866739047322363) → Settings → Conversions API
#   META_CAPI_ACCESS_TOKEN — long EAA… token from "Generate access token"
#   META_TEST_EVENT_CODE   — optional; from "Test Events" tab (e.g. TEST12345)
#                            tagged events appear in real time and are NOT
#                            attributed to ad campaigns. Leave blank in prod.
#   META_PIXEL_ID          — optional override; defaults to 1866739047322363
# Server-side and browser-side events share an event_id (UUID generated by
# the frontend at fire time and forwarded in the API payload) so Events
# Manager counts each conversion once across both transports.
# ─────────────────────────────────────────────────────────────────────
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_PIXEL_ID=1866739047322363
